# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- Groq / LLM ------------------------------------------------------------
# Required. Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0

# --- Database --------------------------------------------------------------
DB_PATH=business_contacts.db

# --- Limits ----------------------------------------------------------------
MAX_EMAIL_LENGTH=20000

# --- Admin auth (HTTP Basic) ----------------------------------------------
# Set BOTH to require login for the admin panel, delete, and Gmail routes.
# Leave unset for open access (not recommended outside local dev).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- CORS ------------------------------------------------------------------
# Comma-separated allow-list (never use "*").
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Gmail / OAuth (optional) ---------------------------------------------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
OAUTH_REDIRECT_URI=http://localhost:8000/oauth2callback
GMAIL_MAX_RESULTS=10

# Allow plain HTTP during the OAuth flow. Local development ONLY.
OAUTH_INSECURE_TRANSPORT=false
